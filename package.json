{
  "name": "job-agent",
  "version": "0.1.0",
  "description": "Five single-purpose AI agents for a tech job search (filter, briefing, editor, sparring partner, ledger) plus an auto-submitter that applies on Greenhouse, Lever and Ashby.",
  "type": "module",
  "bin": {
    "job-agent": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "ui": "tsx src/ui/server.ts",
    "demo": "tsx src/sandbox/run.ts --offline",
    "sandbox": "tsx src/sandbox/run.ts",
    "eval": "tsx src/evals/run.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "commander": "^15.0.0",
    "playwright": "^1.64.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
