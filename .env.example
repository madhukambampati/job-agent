ANTHROPIC_API_KEY=
# Optional: Cohere for evidence retrieval (Embed + Rerank) and/or as the agents' model
COHERE_API_KEY=
# JOB_AGENT_PROVIDER=cohere          # use Cohere Command for every agent decision (web search still uses Claude)
# COHERE_CHAT_MODEL=command-a-03-2025
# COHERE_EMBED_MODEL=embed-v4.0
# COHERE_RERANK_MODEL=rerank-v3.5
# Optional
# JOB_AGENT_MODEL=claude-sonnet-5-5
# JOB_AGENT_CHROME_PATH=/usr/bin/google-chrome   # use installed Chrome instead of Playwright's Chromium
# JOB_AGENT_HEADFUL=1                            # watch the browser fill forms
# JOB_AGENT_PROFILE=config/profile.yaml
# JOB_AGENT_LEDGER=data/ledger.json
